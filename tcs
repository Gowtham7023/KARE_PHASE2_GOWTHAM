// 1) Count frequency of an element in an array
// Input:
// 6
// 10 20 10 30 10 40
// 10
// Output:
// Frequency: 3

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int target = sc.nextInt();
        int count = 0;

        for(int i = 0; i < n; i++) {
            if(arr[i] == target) {
                count++;
            }
        }

        System.out.println("Frequency: " + count);
    }
}


// 2) Find the second largest element
// Input:
// 6
// 10 50 30 40 60 20
// Output:
// Second Largest: 50

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int largest = Integer.MIN_VALUE;
        int second = Integer.MIN_VALUE;

        for(int i = 0; i < n; i++) {
            if(arr[i] > largest) {
                second = largest;
                largest = arr[i];
            }
            else if(arr[i] > second && arr[i] != largest) {
                second = arr[i];
            }
        }

        System.out.println("Second Largest: " + second);
    }
}


// 3) Move all zeros to the end
// Input:
// 6
// 0 1 0 3 12 0
// Output:
// 1 3 12 0 0 0

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        int index = 0;

        for(int i = 0; i < n; i++) {
            if(arr[i] != 0) {
                arr[index] = arr[i];
                index++;
            }
        }

        while(index < n) {
            arr[index] = 0;
            index++;
        }

        for(int i = 0; i < n; i++) {
            System.out.print(arr[i] + " ");
        }
    }
}


// 4) Find duplicate elements in an array
// Input:
// 6
// 10 20 10 30 20 40
// Output:
// 10 20

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int arr[] = new int[n];

        for(int i = 0; i < n; i++) {
            arr[i] = sc.nextInt();
        }

        for(int i = 0; i < n; i++) {
            int count = 0;

            for(int j = 0; j < n; j++) {
                if(arr[i] == arr[j]) {
                    count++;
                }
            }

            boolean already = false;

            for(int j = 0; j < i; j++) {
                if(arr[i] == arr[j]) {
                    already = true;
                    break;
                }
            }

            if(count > 1 && !already) {
                System.out.print(arr[i] + " ");
            }
        }
    }
}


// 5) Find missing number
// Input:
// 5
// 1 2 3 5
// Output:
// Missing Number: 4

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();

        int sum = 0;

        for(int i = 0; i < n - 1; i++) {
            sum = sum + sc.nextInt();
        }

        int total = n * (n + 1) / 2;

        System.out.println("Missing Number: " + (total - sum));
    }
}


// 6) Check palindrome number
// Input:
// 121
// Output:
// PALINDROME NUMBER

import java.util.*;

public class Main {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int n = sc.nextInt();
        int temp = n;
        int reverse = 0;

        while(n != 0) {
            int d = n % 10;
            reverse = reverse * 10 + d;
            n = n / 10;
        }

        if(temp == reverse) {
            System.out.println("PALINDROME NUMBER");
        }
        else {
            System.out.println("NOT A PALINDROME NUMBER");
        }
    }
}



import java.util.*;

public class Main
{
	public static void main(String[] args) {
		Scanner sc=new Scanner(System.in);
		int n=sc.nextInt();
		int count;
		for(int row=0;row<n;row++){
		    if(row%2==0){
		        count=1;
		    }
		    else{
		        count=2;
		    }
		    for(int col=0;col<=row;col++){
		        
		        System.out.print(count);
		        count+=2;
		    }
		    System.out.println();
		}
		
	}
}



// write a java prog to check the given no. is harshed no. or not eg.:18
// step1 : get the user input n=18
// step2 : find the sum of digits sum=9 1+8=9
// step3 : to check the given no. is completely divisible by sum of the digits 18%9==0
// step4 : if it is true print harshad number

import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n=sc.nextInt();
		int sum=0,d;
		int temp=n;
		while(n!=0){
		    d=n%10;
		    sum=sum+d;
		    n=n/10;
		}
		if(temp%sum==0){
		    System.out.println("Harshad number");
		}
		else{
		    System.out.println("Not a Harshad number");
		}
	}
}



// write a java prog to check the given no. is neon no. or not eg.:9
// step1 : get the user input n=9
// step2 : find the square of n = 9^2=81
// step3 : sum of the digits 1+8=9
// step4 : the given no. n and sum of each digit in a square value both are equal it si consider as neon number

import java.util.*;
public class Main
{
	public static void main(String[] args) {
		Scanner sc = new Scanner(System.in);
		int n=sc.nextInt();
		int s=n*n;
		int sum=0,d;
		int temp=n;
		while(s!=0){
		    d=s%10;
		    sum=sum+d;
		    s=s/10;
		}
		if(temp==sum){
		    System.out.println("neon number");
		}
		else{
		    System.out.println("Not a neon number");
		}
	}
}
